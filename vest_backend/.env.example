VEST_DEPLOY_DIR=/home/youruser/vest-deploy
VEST_BACKUP_CRON_SCHEDULE="30 1 * * *"
VEST_BACKUP_REMOTE_HOST=192.168.0.10
VEST_BACKUP_REMOTE_USER=backup-user
VEST_BACKUP_REMOTE_PATH=/srv/backups/vest
VEST_BACKUP_TMP_DIR=/home/youruser/vest-deploy/tmp
VEST_BACKUP_CONTAINER_NAME=vest-deploy-api-1
VEST_DB_CONTAINER_PATH=/app/data/vest.db
VEST_BACKUP_RETENTION_DAYS=14
VEST_BACKUP_LOG=/var/log/vest_backup.log
VEST_API_HEALTH_URL=http://localhost:8002/portal/status
VEST_BACKUP_SSH_OPTS="-o StrictHostKeyChecking=accept-new"
VEST_BACKUP_CONTAINER_TEMP_PATH=/tmp/vest_backup.db
VEST_BACKUP_FILENAME_PREFIX=vest
